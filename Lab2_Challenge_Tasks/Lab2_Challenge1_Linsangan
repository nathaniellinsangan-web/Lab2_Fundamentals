    "import random\n",
    "\n",
    "# ==========================================\n",
    "# CONFIGURATION / INPUT DATA\n",
    "# ==========================================\n",
    "SURNAME = \"SMITH\"    # Replace with your surname\n",
    "SEED_NUM = 42        # Replace with your assigned SEED_NUM\n",
    "NUM_READINGS = 10    # Fixed number of sensor readings to process\n",
    "\n",
    "# Define operating ranges for validation and classification\n",
    "MIN_VALID = 0.0\n",
    "MAX_VALID = 100.0\n",
    "\n",
    "LOW_THRESHOLD = 30.0\n",
    "NORMAL_THRESHOLD = 70.0\n",
    "\n",
    "# ==========================================\n",
    "# 1. GENERATE SENSOR DATA\n",
    "# ==========================================\n",
    "# Use seed based on surname and SEED_NUM for unique but reproducible generation\n",
    "seed_value = sum(ord(char) for char in SURNAME) + SEED_NUM\n",
    "random.seed(seed_value)\n",
    "\n",
    "generated_data = []\n",
    "# Generating readings (including potential invalid/out-of-range values)\n",
    "for _ in range(NUM_READINGS):\n",
    "    # Generates values roughly between -20.0 and 120.0\n",
    "    val = round(random.uniform(-20.0, 120.0), 2)\n",
    "    generated_data.append(val)\n",
    "\n",
    "# ==========================================\n",
    "# 2. PROCESS, VALIDATE, & CLASSIFY DATA\n",
    "# ==========================================\n",
    "valid_invalid_results = []\n",
    "classification_results = []\n",
    "execution_log = []\n",
    "\n",
    "valid_count = 0\n",
    "invalid_count = 0\n",
    "\n",
    "low_count = 0\n",
    "normal_count = 0\n",
    "high_count = 0\n",
    "\n",
    "for idx, reading in enumerate(generated_data, start=1):\n",
    "    # Validation step\n",
    "    if MIN_VALID <= reading <= MAX_VALID:\n",
    "        valid_invalid_results.append(\"Valid\")\n",
    "        valid_count += 1\n",
    "        \n",
    "        # Classification step for valid readings\n",
    "        if reading < LOW_THRESHOLD:\n",
    "            category = \"Low\"\n",
    "            low_count += 1\n",
    "        elif reading <= NORMAL_THRESHOLD:\n",
    "            category = \"Normal\"\n",
    "            normal_count += 1\n",
    "        else:\n",
    "            category = \"High\"\n",
    "            high_count += 1\n",
    "            \n",
    "        classification_results.append(category)\n",
    "        execution_log.append(f\"Entry {idx}: {reading} -> VALID ({category})\")\n",
    "    else:\n",
    "        valid_invalid_results.append(\"Invalid\")\n",
    "        classification_results.append(\"N/A\")\n",
    "        invalid_count += 1\n",
    "        execution_log.append(f\"Entry {idx}: {reading} -> INVALID (Out of range)\")\n",
    "\n",
    "# ==========================================\n",
    "# 3. ASSESSMENT DATA OUTPUT\n",
    "# ==========================================\n",
    "print(\"==========================================\")\n",
    "print(\"            ASSESSMENT DATA               \")\n",
    "print(\"==========================================\")\n",
    "\n",
    "print(f\"Generated Sensor Data: {generated_data}\")\n",
    "print(f\"Valid/Invalid Results: {valid_invalid_results}\")\n",
    "print(f\"Classification Results: {classification_results}\")\n",
    "\n",
    "print(\"\\nExecution Log:\")\n",
    "for log_entry in execution_log:\n",
    "    print(f\"  {log_entry}\")\n",
    "\n",
    "print(\"\\nFinal Output:\")\n",
    "print(\"  --- SUMMARY REPORT ---\")\n",
    "print(f\"  Total Readings Processed : {NUM_READINGS}\")\n",
    "print(f\"  Valid Readings           : {valid_count}\")\n",
    "print(f\"  Invalid Readings         : {invalid_count}\")\n",
    "print(\"  ----------------------\")\n",
    "print(\"  Operating Range Classification (Valid Only):\")\n",
    "print(f\"    - Low (< {LOW_THRESHOLD})      : {low_count}\")\n",
    "print(f\"    - Normal ({LOW_THRESHOLD}-{NORMAL_THRESHOLD}): {normal_count}\")\n",
    "print(f\"    - High (> {NORMAL_THRESHOLD})     : {high_count}\")\n",
    "print(\"==========================================\")"
